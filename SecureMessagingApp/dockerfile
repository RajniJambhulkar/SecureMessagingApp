# ---------- Stage 1: Build Angular (client) ----------
FROM node:22-alpine AS client-build
WORKDIR /src/client

COPY client/package*.json ./
RUN npm ci

COPY client/ ./
RUN npm run build


# ---------- Stage 2: Build ASP.NET Web API ----------
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS api-build
WORKDIR /src

COPY API/*.csproj ./API/
RUN dotnet restore ./API

COPY API/ ./API/
RUN dotnet publish ./API -c Release -o /app/publish --no-restore


# ---------- Stage 3: Runtime ----------
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

COPY --from=api-build /app/publish ./

# Angular 21 outputs to dist/<project-name>/browser
COPY --from=client-build /src/client/dist/*/browser ./wwwroot

ENV ASPNETCORE_ENVIRONMENT=Production

# Render injects $PORT. Replace API.dll with your actual assembly name.
CMD ASPNETCORE_URLS=http://+:${PORT:-8080} dotnet API.dll
